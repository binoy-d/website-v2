# Copy to `.env` (on the server this happens automatically on first deploy).
# `.env` is git-ignored and never synced by the deploy script.

# ---- compose ----
# Host port the site is published on. Point your reverse proxy / tunnel at it.
WEB_PORT=8088
# Interface to bind. Use 127.0.0.1 if only a local reverse proxy/tunnel should reach it.
WEB_BIND=0.0.0.0

# ---- api ----
# Bearer token for GET /api/admin/messages (read contact-form submissions).
# Generate one with: openssl rand -hex 32   (leave empty to disable the endpoint)
ADMIN_TOKEN=

# Optional: email me each contact-form submission. Leave SMTP_HOST empty to disable.
# Submissions are always stored in the database either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=dbinoy15@gmail.com
CONTACT_FROM=

# ---- highlights (BookOrbit) ----
# Base URL of the BookOrbit instance as seen from the api container. host.docker.internal
# resolves to the Docker host (see compose.yaml), so this reaches BookOrbit on host port 3000.
# Leave empty to disable the Highlights page data (the page shows a "not configured" message).
BOOKORBIT_URL=http://host.docker.internal:3000
# Credentials for the BookOrbit account whose highlights are shown. BookOrbit has no API keys:
# use a reusable magic-link token (preferred; revocable in BookOrbit)...
BOOKORBIT_MAGIC_TOKEN=
# ...or a username + password.
BOOKORBIT_USERNAME=
BOOKORBIT_PASSWORD=

# Optional: contact-form rate limit per client IP (defaults: 5 per hour)
# CONTACT_RATE_MAX=5
# CONTACT_RATE_WINDOW_MS=3600000
